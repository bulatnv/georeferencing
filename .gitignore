.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Кэш тайлов подложки и артефакты стенда (фазы 2+).
cache/
tiles/
data/
*.npy
*.npz
*.faiss

# Тестовые бортовые снимки и датасеты (чужие данные ГБ, не в репозитории).
test_images/
for_binding/
*.csv

# IDE.
.idea/

# Слепок окружения, не артефакт проекта.
freeze.txt
maps/
eval_out/

# Внешние чекпоинты (GIM/MINIMA и т.п.) — чужие данные на сотни МБ.
weights/

# Отчёты инструмента локализации (out/ по умолчанию).
out/

# Отчёты прогонов инструмента.
out_all/

# Рабочие артефакты пилота open_orto (поля сдвигов, отчёты прогонов,
# кропы гейта) — воспроизводятся скриптами, в историю не идут
open_orto/work/
open_orto/dataset/

# Каталог поставки: сами пары — 15 ГБ жёстких ссылок на рабочие корпуса, и
# тяжёлая визуальная сводка. Опись (manifest.csv) и README остаются в истории:
# по ним видно, из чего датасет собран, даже когда данных под рукой нет.
openaerialmap_dataset/*.npz
openaerialmap_dataset/SUMMARY.html
openaerialmap_dataset/MATCHERS_REPORT.html
openaerialmap_dataset/PAIR_ANATOMY.html
openaerialmap_dataset/DUPLICATES.html
openaerialmap_dataset/MODALITY.html
# опись поставки нужна в истории, несмотря на общее правило *.csv выше
!openaerialmap_dataset/manifest.csv
!openaerialmap_dataset/rasters_inventory.csv
!openaerialmap_dataset/scene_modality.csv
